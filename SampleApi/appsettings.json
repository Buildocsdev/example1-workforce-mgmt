{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "BuildocsApi",
    "Audience": "BuildocsClient"
  },
  "AWS": {
    "Region": "us-east-1",
    "DynamoDB": {
      "ServiceURL": "http://localhost:8000",
      "FormRecordsTable": "FormRecords"
    },
    "S3": {
      "ServiceURL": "http://localhost:9000",
      "ForcePathStyle": true,
      "AccessKey": "admin",
      "SecretKey": "adminpassword",
      "BucketName": "buildocs-demo",
      "TenantId": "demo"
    }
  }
}